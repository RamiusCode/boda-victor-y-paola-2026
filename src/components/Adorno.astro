---
// src/components/Adorno.astro
// El adorno dorado de la invitación: dos líneas que se afinan hacia un
// rombo, con un punto a cada lado. Toma el color del texto (currentColor),
// así que cada bloque lo pinta con su dorado.
//
// Los degradados necesitan ids, y repetidos en la página el navegador usa
// siempre el primero: cada adorno arma los suyos con un sufijo propio.
interface Props {
    id?: string;
    class?: string;
    [atributo: string]: unknown;
}

// El resto de los props se reenvía: ahí viaja el atributo con el que Astro
// aplica los estilos del bloque que lo usa (su .adorno de tamaño y color)
const { id, class: clase, ...resto } = Astro.props;
const sufijo = Math.random().toString(36).slice(2, 8);
const izq = `adorno-izq-${sufijo}`;
const der = `adorno-der-${sufijo}`;
---

<svg
    id={id}
    class={clase}
    {...resto}
    viewBox="0 0 220 20"
    aria-hidden="true"
    focusable="false"
>
    <defs>
        <linearGradient id={izq} x1="0" x2="1">
            <stop offset="0" stop-color="currentColor" stop-opacity="0" />
            <stop offset="1" stop-color="currentColor" />
        </linearGradient>
        <linearGradient id={der} x1="1" x2="0">
            <stop offset="0" stop-color="currentColor" stop-opacity="0" />
            <stop offset="1" stop-color="currentColor" />
        </linearGradient>
    </defs>
    <rect x="0" y="9.5" width="92" height="1" fill={`url(#${izq})`} />
    <rect x="128" y="9.5" width="92" height="1" fill={`url(#${der})`} />
    <path
        d="M110 2 L118 10 L110 18 L102 10 Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
    />
    <path d="M110 6.5 L113.5 10 L110 13.5 L106.5 10 Z" fill="currentColor" />
    <circle cx="97" cy="10" r="1.3" fill="currentColor" />
    <circle cx="123" cy="10" r="1.3" fill="currentColor" />
</svg>
