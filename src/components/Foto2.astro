---
// src/components/Foto2.astro
// Foto de los novios a todo el ancho, con el borde de papel rasgado arriba y
// abajo, sin marco. Al bajar, la foto llega agrandada dentro de su recorte y
// se va acomodando a su tamaño a medida que el invitado scrollea, igual que
// Foto1.
//
// El rasgado va en el contenedor y el zoom en la foto de adentro: así el
// borde roto queda quieto mientras la imagen se mueve detrás.
import { mascaraRasgada } from "../scripts/rasgado";

// ── DATOS EDITABLES ───────────────────────────────────────────
const altFoto = "Los novios";
// ──────────────────────────────────────────────────────────────

// La foto es apaisada (900 x 555): con el rasgado arriba y abajo se comía
// casi la mitad. El recorte va en 900 x 700 y la foto lo cubre recortando
// apenas los costados, donde no hay nadie.
const ANCHO = 900;
const ALTO = 700;
const mascaraUrl = mascaraRasgada({
    ancho: ANCHO,
    alto: ALTO,
    arriba: true,
    abajo: true,
    semilla: 41,
});
---

<section id="foto2" class="seccion-foto">
    <div
        class="recorte"
        style={`aspect-ratio: ${ANCHO} / ${ALTO}; -webkit-mask-image: ${mascaraUrl}; mask-image: ${mascaraUrl};`}
    >
        <img
            id="foto2-imagen"
            src="/imagenes/foto2.jpg"
            alt={altFoto}
            width="900"
            height="555"
            class="foto"
        />
    </div>
</section>

<style>
    .seccion-foto {
        width: 100%;
        max-width: 430px;
        margin: 0 auto;
    }

    /* El recorte rasgado; lo que la foto agrandada saca afuera no se ve */
    .recorte {
        overflow: hidden;
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
    }

    .foto {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        will-change: transform;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("foto2");
        const foto = document.getElementById("foto2-imagen");
        if (!seccion || !foto) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            return;
        }

        // Igual que Foto1: entra agrandada y un poco corrida hacia abajo, y
        // vuelve a su tamaño al llegar al centro de la pantalla, atada al
        // scroll para que acompañe al dedo en los dos sentidos.
        gsap.fromTo(
            foto,
            { scale: 1.3, yPercent: 7, opacity: 0.35 },
            {
                scale: 1,
                yPercent: 0,
                opacity: 1,
                ease: "none",
                scrollTrigger: {
                    trigger: seccion,
                    start: "top bottom",
                    end: "center center",
                    scrub: 1.2,
                },
            },
        );
    });
</script>
