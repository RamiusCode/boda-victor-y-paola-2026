---
// src/components/DiaEvento.astro
// La cabecera de cada día de celebración, antes de sus tarjetas de lugar.
// La boda dura tres días: sin esto, las dos "Recepción" se confunden.
//
// Arriba "Primer día" en Great Vibes dorado; debajo una hoja de calendario
// de papel con el día de la semana en una franja roja, el número grande en
// Cormorant y el mes en dorado; y al pie, en Charm, lo que se celebra ese día.
interface Props {
    id: string;
    /** "Primer día", "Segundo día"... */
    orden: string;
    /** "Sábado" */
    semana: string;
    numero: number;
    /** "Diciembre" */
    mes: string;
    /** lo que se celebra ese día, en una línea */
    resumen: string;
}

const { id, orden, semana, numero, mes, resumen } = Astro.props;
---

<section id={id} class="dia-evento">
    <h2 class="orden font-great-vibes">{orden}</h2>

    <div class="hoja" aria-label={`${semana} ${numero} de ${mes}`}>
        <span class="semana">{semana}</span>
        <span class="numero">{numero}</span>
        <span class="mes">{mes}</span>
    </div>

    <p class="resumen font-charm">{resumen}</p>
</section>

<style>
    .dia-evento {
        --azul: #8e1426;
        --dorado: #c6a24a;
        --dorado-suave: rgba(198, 162, 74, 0.45);

        width: 100%;
        max-width: 430px;
        margin: 0 auto;
        /* Más aire arriba que abajo: abre un día nuevo y se pega a sus tarjetas */
        padding: 3.2rem 1.6rem 0;
        text-align: center;
        font-family: "Cormorant Garamond", serif;
        color: var(--azul);
    }

    .orden {
        color: var(--dorado);
        font-size: clamp(2.4rem, 11.5vw, 3rem);
        line-height: 1.15;
        font-weight: 400;
        /* Great Vibes trae poco aire entre palabras */
        word-spacing: 0.15em;
    }

    /* La hoja de calendario: papel con doble filo dorado, como la cuenta regresiva */
    .hoja {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: clamp(118px, 34vw, 136px);
        margin: 0.9rem auto 0;
        overflow: hidden;
        border: 1px solid var(--dorado-suave);
        border-radius: 14px;
        background-color: #fdf9f1;
        box-shadow:
            inset 0 0 0 3px rgba(255, 255, 255, 0.7),
            0 8px 18px rgba(142, 20, 38, 0.12);
    }

    /* El día de la semana en la franja roja de arriba, en letras blancas */
    .semana {
        width: 100%;
        padding: 0.45rem 0 0.4rem;
        background-color: var(--azul);
        color: #ffffff;
        font-size: clamp(0.9rem, 4.2vw, 1rem);
        font-weight: 700;
        letter-spacing: 0.18em;
        /* el text-indent compensa el espacio que queda tras la última letra */
        text-indent: 0.18em;
        text-transform: uppercase;
    }

    /* El número, grande y en otra letra que el resto: lo primero que se lee */
    .numero {
        margin-top: 0.2rem;
        font-size: clamp(3.4rem, 16vw, 4rem);
        font-weight: 700;
        line-height: 1;
        /* números de igual alto, sin los descendentes de Cormorant */
        font-variant-numeric: lining-nums;
    }

    .mes {
        margin: 0.15rem 0 0.6rem;
        color: var(--dorado);
        font-size: clamp(0.82rem, 3.8vw, 0.92rem);
        font-weight: 700;
        letter-spacing: 0.16em;
        text-indent: 0.16em;
        text-transform: uppercase;
    }

    .resumen {
        max-width: 19rem;
        margin: 0.9rem auto 0;
        font-size: clamp(1.25rem, 5.8vw, 1.45rem);
        line-height: 1.4;
    }
</style>

<script>
    import { entradaConjunta, gestos } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        // Un bloque por día: cada uno se anima solo al asomar
        document.querySelectorAll<HTMLElement>(".dia-evento").forEach((dia) => {
            const $ = (sel: string) => dia.querySelector(sel);

            // El título se escribe, la hoja se acerca y el resumen sube
            entradaConjunta(dia, [
                [$(".orden"), gestos.trazo],
                [$(".hoja"), gestos.acercar],
                [$(".resumen"), gestos.subir],
            ]);
        });
    });
</script>
