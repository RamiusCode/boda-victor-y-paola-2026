---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <link rel="icon" type="image/png" href="/iconos/Anillos.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!--
       Vista previa al compartir el link por WhatsApp. La imagen se genera
       aparte en 1200x630 (miniatura.jpg): WhatsApp usa una franja ancha y
       recorta arriba y abajo, así que la miniatura va entera adentro con
       los costados rellenos.

       Sin og:description no se dibuja el renglón de texto bajo el título.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={new URL("/miniatura.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:image"
      content={new URL("/miniatura.jpg", Astro.site)}
    />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Un solo pedido a Google. Charm y Great Vibes, la de títulos y nombres, van desde /fonts/ -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Forzar modo claro y evitar dark mode del navegador */
      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        color-scheme: only light;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        color-scheme: only light;
        /* Fuera de la columna móvil (tablet / PC) */
        background-color: #e9e4dd;
      }

      /* La invitación SIEMPRE se ve como celular: columna centrada */
      main {
        width: 100%;
        max-width: 430px;
        margin: 0 auto;
        min-height: 100vh;
        position: relative;
        /* el fondo de abajo queda detrás de todos los bloques */
        isolation: isolate;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.08);
      }

      /*
         Un solo fondo de papel para toda la invitación, quieto mientras se
         scrollea. Va como capa fija y no con background-attachment: fixed,
         que Safari de iPhone ignora. Ocupa todo el ancho de la columna y se
         estira en alto hasta llenar la pantalla del celular.
         Al ser imagen, el modo oscuro forzado no lo oscurece.
      */
      main::before {
        content: "";
        position: fixed;
        z-index: -1;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        max-width: 430px;
        height: 100vh;
        /* alto de pantalla con la barra del navegador escondida: no salta al scrollear */
        height: 100lvh;
        background-color: #f7f5f2;
        background-image: url("/imagenes/fondoblanco.jpg");
        background-size: 100% 100%;
        background-repeat: no-repeat;
        pointer-events: none;
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>
